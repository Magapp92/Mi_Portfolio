# Puerto en el que arranca la API en local
PORT=3000

# Cadena de conexión de MongoDB Atlas (lleva usuario y contraseña: es secreta)
MONGO_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/basededatos

# Token de administración para crear, editar o borrar preguntas del quiz.
# Genera uno largo y aleatorio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=pon-aqui-un-token-largo-y-aleatorio
