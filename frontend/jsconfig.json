{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@components/*": ["src/components/*"],
            "@pages/*": ["src/pages/*"],
            "@hooks/*": ["src/hooks/*"],
            "@context/*": ["src/context/*"],
            "@const/*": ["src/const/*"],
            "@data/*": ["src/data/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
